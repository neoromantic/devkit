{
  "name": "@goodit/devkit",
  "version": "1.6.1",
  "description": "Shared CI workflows, git hooks, templates and agent rules for neoromantic's open-source repos",
  "license": "MIT",
  "author": "Sergey Petrov",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neoromantic/devkit.git"
  },
  "homepage": "https://github.com/neoromantic/devkit#readme",
  "bugs": "https://github.com/neoromantic/devkit/issues",
  "packageManager": "bun@1.4.2",
  "bin": {
    "devkit": "scripts/cli.ts"
  },
  "files": [
    "scripts",
    "lefthook",
    ".lefthook",
    "renovate",
    "templates",
    "agents"
  ],
  "scripts": {
    "check": "bun run format:check && bun run lint && tsc --noEmit && bun run check:knip",
    "check:knip": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "test": "bun test",
    "privacy-scan": "bun scripts/privacy-scan.ts",
    "sync": "bun scripts/sync.ts",
    "repo-settings": "bun scripts/repo-settings.ts",
    "status": "bun scripts/status.ts"
  },
  "devDependencies": {
    "@interfere/landmines": "0.1.0",
    "@types/bun": "1.4.3",
    "knip": "6.45.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  }
}
